DATABASE_URL=file:./dev.db

PORT=3001
NODE_ENV=development

CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=26214400


# Neon Object Storage (S3-compatible) - values injected by `neon deploy`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
STORAGE_PUBLIC_BUCKET=public-assets
STORAGE_PRIVATE_BUCKET=hand-crops

MATCH_THRESHOLD=
MIN_CONFIDENCE=

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

JWT_SECRET=
# Set your real admin Gmail and a strong password in the deployment environment.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@12345
TEACHER_EMAIL=
TEACHER_PASSWORD=
GOOGLE_CLIENT_ID=
