generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model Gesture {
  id           Int          @id @default(autoincrement())
  word         String
  wordKey      String       @unique
  language     String       @default("English")
  translations Json         @default("{}")
  aliases      String[]     @default([])
  landmarks    Json?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  samples      SignGesture[]
  assets       SignAsset[]

  @@index([word])
  @@index([language])
  @@index([isActive])
}

model SignGesture {
  id           Int      @id @default(autoincrement())
  word         String
  language     String   @default("FSL")
  gestureType  String   @default("dynamic")
  features     Json
  sequence    Json?
  frameCount   Int      @default(0)
  handCropUrl  String?
  description  String?
  isActive     Boolean  @default(true)
  gestureId    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  gesture      Gesture? @relation(fields: [gestureId], references: [id], onDelete: SetNull)

  @@index([word])
  @@index([language])
  @@index([gestureType])
  @@index([isActive])
  @@index([gestureId])
}

model SignAsset {
  id          Int      @id @default(autoincrement())
  word        String
  file        String
  type        String
  isPublished Boolean  @default(true)
  gestureId   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  gesture     Gesture? @relation(fields: [gestureId], references: [id], onDelete: SetNull)

  @@index([word])
  @@index([gestureId])
}

model Keyword {
  id        Int      @id @default(autoincrement())
  language  String
  keyword   String
  value     String
  createdAt DateTime @default(now())

  @@unique([language, keyword])
}

model AISentenceHistory {
  id               Int      @id @default(autoincrement())
  language         String   @default("FSL")
  rawGestureInput  String
  composedSentence String
  normalizedInput  String?
  createdAt        DateTime @default(now())

  @@index([language])
}

model ModelTraining {
  id               Int      @id @default(autoincrement())
  modelName        String
  version          String
  accuracy         Float?
  precision        Float?
  recall           Float?
  f1Score          Float?
  trainingSamples  Int      @default(0)
  createdAt        DateTime @default(now())
}

model RecognitionLog {
  id               Int      @id @default(autoincrement())
  predictedWord    String?
  confidence       Float?
  features         Json?
  createdAt        DateTime @default(now())

  @@index([predictedWord])
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String?
  googleId   String?  @unique
  role       Role     @default(STUDENT)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([role])
}

model TeacherInvite {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  invitedBy String?
  usedAt    DateTime?
  createdAt DateTime @default(now())
}
