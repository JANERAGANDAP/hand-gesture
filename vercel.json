{
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix sign-language-server",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "sign-language-server/dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__route=:path*" },
    { "source": "/:path((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}